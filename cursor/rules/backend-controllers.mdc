## 3. Example Shape

```javascript
import Errr from "errr";
import { z } from "zod";

import LoggerProxy from "../proxies/logger-proxy.js";
import { PartnerSyncService } from "../services/partner-sync-service.js";
import PartnerSyncState from "../state/partner-sync-state.js";
import { Validator } from "../validator.js";

const accountSyncPayloadSchema = z.object({
  type: z.literal("FULL_LEAGUE_SYNC"),
  userId: z.string(),
  sport: z.string().optional(),
  season: z.string().optional(),
});

export class PartnerSyncController {
  
  static async loadAllPublicAndPrivateData(payload, context = {}) {
    const { messageId, body } = context;

    try {
      const normalized = Validator.validate(accountSyncPayloadSchema, payload, {
        eventType: "FULL_LEAGUE_SYNC",
      });
      const state = new PartnerSyncState(normalized);
      await PartnerSyncService.loadAllPublicAndPrivateData(state);
      
      // 3. Extract and return summary
      const summary = state.getImportSummary();
      LoggerProxy.debug("[sync] Complete. Summary:", summary);
      return summary;
      
    } catch (err) {
      // 4. Wrap error with debug context, log, and rethrow
      const error = Errr.newError("Failed to process sync SQS record")
        .appendTo(err)
        .debug({ messageId, body })
        .get();

      LoggerProxy.error("Failed to process sync SQS record", { messageId }, error);
      throw error;
    }
  }
}
```

---

## 4. Verification & Testing (Maddox Controller Coverage)

-   **Maddox Entry-Point Coverage:** Every public static method on an exported controller class **must** have its own Maddox suite with `.withEntryPoint(<ControllerClass>, "<methodName>")`.
-   **What to Mock:** Mock entities / repositories / proxies / modules that **steps** call. The Service and Steps run for real (`enforce-no-service-entry-point-in-maddox-spec`, `enforce-no-step-mock-in-maddox-test`).
-   **Never mock the Service** in a controller spec. Never mock `PostgresProxy`.
