  describe("calling runWithPromiseAll [stepName] (with Promise.all), it", function () {
    let context;

    beforeEach(() => {
      // Only the context reset (`context = {}`) and attaching `context.setup…` functions belong here.
      // We never run fixture logic in `beforeEach` outside of those function declarations (except the reset).
      context = {};

      context.setupValues = () => {
        context.row = new RowMockBuilder().get();
      };

      context.setupInputParams = () => {
        // Maddox uses `fn.apply(entryPoint, inputParams)` — one element ⇒ one module argument: plain object.
        context.stepInput = {
          recordId: context.row.id,
          params: { id: context.row.id, source: "parent-service-orchestration" },
        };
        context.inputParams = [context.stepInput];
      };

      context.setupGetSomeModel = () => {
        context.modelGetParams = [context.row.id];
        context.modelGetResponse = structuredClone(context.row);
        context.modelGetError = new Error(`SomeModel.get: ${Mock.getHash()}`);
      };

      /** First `HttpProxy.post` inside `Promise.all` (stable assertion order: A then B). */
      context.setupParallelHttpPostFirst = () => {
        context.httpProxyParallelFirstParams = [
          context.modelGetResponse.url,
          context.modelGetResponse.payload,
        ];
        context.httpProxyParallelFirstResponse = { status: 200, body: { branch: "a" } };
        context.httpProxyParallelFirstError = new Error(
          `HttpProxy.post (parallel A): ${Mock.getHash()}`
        );
      };

      /** Second `HttpProxy.post` inside the same `Promise.all` (same mock label, second invocation). */
      context.setupParallelHttpPostSecond = () => {
        context.httpProxyParallelSecondParams = [
          context.modelGetResponse.secondaryUrl,
          context.modelGetResponse.secondaryPayload,
        ];
        context.httpProxyParallelSecondResponse = { status: 200, body: { branch: "b" } };
        context.httpProxyParallelSecondError = new Error(
          `HttpProxy.post (parallel B): ${Mock.getHash()}`
        );
      };

      context.setupSaveSomeEntity = () => {
        context.entitySaveParams = [context.modelGetResponse];
        context.entitySaveResponse = structuredClone(context.modelGetResponse);
        context.entitySaveError = new Error(`SomeEntity.save: ${Mock.getHash()}`);
      };

      context.setupResponse = () => {
        context.expectedResponse = { data: structuredClone(context.row) };
      };
    });

    it("should complete the flow (two HttpProxy.post calls in Promise.all after get).", async function () {
      context.setupValues();
      context.setupInputParams();
      context.setupGetSomeModel();
      context.setupParallelHttpPostFirst();
      context.setupParallelHttpPostSecond();
      context.setupSaveSomeEntity();
      context.setupResponse();

      await new Promise((resolve, reject) => {
        /**
         * mockThisFunction order is first-use: Model → HttpProxy → Entity. `HttpProxy.post` is registered
         * once; assert it twice in stable order (parallel A, then parallel B), then Entity.save.
         */
        new Scenario(this)
          .mockThisFunction("SomeModel", "get", SomeModel)
          .mockThisFunction("HttpProxy", "post", HttpProxy)
          .mockThisFunction("SomeEntity", "save", SomeEntity)

          .withEntryPoint(ExampleModule, "runWithPromiseAll")
          .withInputParams(context.inputParams)

          .shouldBeCalledWith("SomeModel", "get", context.modelGetParams)
          .doesReturnWithPromise("SomeModel", "get", context.modelGetResponse)

          .shouldBeCalledWith("HttpProxy", "post", context.httpProxyParallelFirstParams)
          .doesReturnWithPromise("HttpProxy", "post", context.httpProxyParallelFirstResponse)

          .shouldBeCalledWith("HttpProxy", "post", context.httpProxyParallelSecondParams)
          .doesReturnWithPromise("HttpProxy", "post", context.httpProxyParallelSecondResponse)

          .shouldBeCalledWith("SomeEntity", "save", context.entitySaveParams)
          .doesReturnWithPromise("SomeEntity", "save", context.entitySaveResponse)

          .test((err, response) => {
            // Success: (1) no error, (2) response matches expected aggregate.
            Maddox.compare.equal(err, undefined);
            Maddox.compare.equal(response, context.expectedResponse);
            resolve();
          })
          .catch((err) => {
            reject(err.stack);
          });
      });
    });

    // Failure cases follow the same order as `.mockThisFunction`: SomeModel.get → HttpProxy.post → HttpProxy.post → SomeEntity.save.
    // "should handle error from [DependencyLabel].[methodName].",
    it("should handle error from SomeModel.get.", async function () {
      context.setupValues();
      context.setupInputParams();
      context.setupGetSomeModel();
      context.setupParallelHttpPostFirst();
      context.setupParallelHttpPostSecond();
      context.setupSaveSomeEntity();
      context.setupResponse();

      await new Promise((resolve, reject) => {
        new Scenario(this)
          .mockThisFunction("SomeModel", "get", SomeModel)
          .mockThisFunction("HttpProxy", "post", HttpProxy)
          .mockThisFunction("SomeEntity", "save", SomeEntity)

          .withEntryPoint(ExampleModule, "runWithPromiseAll")
          .withInputParams(context.inputParams)

          .shouldBeCalledWith("SomeModel", "get", context.modelGetParams)
          .doesErrorWithPromise("SomeModel", "get", context.modelGetError)

          .test((err, response) => {
            // (1) `err.stack` contains expected message substring(s) (user-facing + upstream); one or more `containsError` checks.
            Maddox.compare.containsError(err, context.modelGetError.message);
