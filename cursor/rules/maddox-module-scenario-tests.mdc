    });

    it("should handle error from SomeEntity.save.", async function () {
      context.setupValues();
      context.setupInputParams();
      context.setupGetSomeModel();
      context.setupFooServiceSaveDraftPost();
      context.setupBarServiceNotifyPost();
      context.setupSaveSomeEntity();
