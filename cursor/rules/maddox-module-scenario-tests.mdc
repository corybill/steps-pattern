      await new Promise((resolve, reject) => {
        new Scenario(this)
          .mockThisFunction("SomeModel", "get", SomeModel)
          .mockThisFunction("HttpProxy", "post", HttpProxy)
          .mockThisFunction("SomeEntity", "save", SomeEntity)

          .withEntryPoint(ExampleModule, "runSequential")
          .withInputParams(context.inputParams)

          .shouldBeCalledWith("SomeModel", "get", context.modelGetParams)
          .doesReturnWithPromise("SomeModel", "get", context.modelGetResponse)

          .shouldBeCalledWith("HttpProxy", "post", context.fooServiceSaveDraftPostParams)
          .doesReturnWithPromise("HttpProxy", "post", context.fooServiceSaveDraftPostResponse)

          .shouldBeCalledWith("HttpProxy", "post", context.barServiceNotifyPostParams)
          .doesReturnWithPromise("HttpProxy", "post", context.barServiceNotifyPostResponse)

          .shouldBeCalledWith("SomeEntity", "save", context.entitySaveParams)
          .doesErrorWithPromise("SomeEntity", "save", context.entitySaveError)

          .test((err, response) => {
